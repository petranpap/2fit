{
  "expo": {
    "name": "2fit",
    "slug": "2fit",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-splash-screen",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Το 2fit χρησιμοποιεί την τοποθεσία σου για να δείξει γυμναστήρια, προπονητές και καταστήματα κοντά σου."
        }
      ]
    ]
  }
}
